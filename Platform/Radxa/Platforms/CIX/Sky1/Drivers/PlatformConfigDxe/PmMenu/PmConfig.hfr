/** CPU minimum nominal voltage setup. SPDX-License-Identifier: BSD-2-Clause-Patent */
form formid = PM_CONFIG_FORM_ID,
  title = STRING_TOKEN(STR_PM_TITLE);
  subtitle text = STRING_TOKEN(STR_PM_BOOT);
  subtitle text = STRING_TOKEN(STR_PM_UNVERIFIED);
  suppressif ideqval RadxaCpuOcStatusVar.CustomSupported == 1;
    subtitle text = STRING_TOKEN(STR_PM_UNSUPPORTED);
  endif;
  oneof varid = RadxaCpuOcVar.Profile,
    prompt = STRING_TOKEN(STR_PM_PROFILE),
    help = STRING_TOKEN(STR_PM_HELP),
    option text = STRING_TOKEN(STR_PM_VENDOR), value = 0, flags = DEFAULT | RESET_REQUIRED;
    suppressif ideqval RadxaCpuOcStatusVar.CustomSupported == 0;
      option text = STRING_TOKEN(STR_PM_CUSTOM), value = 2, flags = RESET_REQUIRED;
    endif;
  endoneof;
  grayoutif TRUE;
