/** CPU setup strings. SPDX-License-Identifier: BSD-2-Clause-Patent */
#langdef en-US "English"
#string STR_PM_TITLE #language en-US "CPU overclocking"
#string STR_PM_HELP #language en-US "Save a CPU-only profile. PM consumes it after a cold reset. Custom requires verified compatible PM firmware and may be rejected for the actual board rails. Hardware recovery may be required after interrupted writes or unstable settings."
#string STR_PM_PROFILE #language en-US "Requested profile"
#string STR_PM_VENDOR #language en-US "Vendor (native CPU OPP policy)"
#string STR_PM_CUSTOM #language en-US "Custom minimum voltage"
#string STR_PM_SAVED #language en-US "Saved PM-sector profile"
#string STR_PM_LEGACY #language en-US "Foreign external OPP table (preserved)"
#string STR_PM_UNKNOWN #language en-US "Unknown"
#string STR_PM_UNSUPPORTED #language en-US "Custom is unavailable: installed PM firmware is not verified for CPU OC ABI 5."
#string STR_PM_UNVERIFIED #language en-US "Saved settings and PM acceptance are reported separately. Acceptance does not verify delivered clocks, voltages or stability."
#string STR_PM_BOOT #language en-US "BIG/MID boot entry requests stay at 1500 MHz / 790 mV. Frequencies must increase; voltages must not decrease."
#string STR_PM_ERROR #language en-US "Last firmware configuration error"
#string STR_PM_ERR_HELP #language en-US "0 none; 1 unsupported PM; 2 invalid settings; 3 invalid PM sector; 4 flash read; 5 flash write; 6 readback mismatch; 7 allocation; 8 status variable; 9 foreign external OPP table preserved. No automatic flash rollback is provided."
#string STR_PM_STATE #language en-US "Request persistence state"
#string STR_PM_READY #language en-US "Sector matched request at last boot"
#string STR_PM_PENDING #language en-US "Cold reset pending"
#string STR_PM_FAILED #language en-US "Persistence failed or unconfirmed; see error"
#string STR_PM_FREQ_HELP #language en-US "MHz, 10 MHz steps. Strictly increasing; BIG and MID maximum 3200. A format limit is not a stability guarantee."
#string STR_PM_VOLT_HELP #language en-US "Minimum nominal voltage, 550-1250 mV in 10 mV steps. PM adds the board margin (normally +30 mV). Coupling may raise programmable CPU/DSU rails. O6N fixed DSU/LITTLE can cause higher requests to be rejected; the menu ceiling is not a board capability. DSU frequency remains native. LITTLE has separate optional settings. Values must not decrease."
#string STR_PM_RUNTIME #language en-US "PM result for this boot"
#string STR_PM_RUNTIME_HELP #language en-US "Reported by PM and matched to the saved PM sector. This describes admission of the complete CPU profile, not measured clock or voltage. It is refreshed at boot."
#string STR_PM_RUNTIME_UNKNOWN #language en-US "Unconfirmed (no valid PM result)"
#string STR_PM_RUNTIME_INACTIVE #language en-US "Custom inactive"
#string STR_PM_RUNTIME_ACCEPTED #language en-US "Custom accepted"
#string STR_PM_RUNTIME_REJECTED #language en-US "Custom/configuration rejected"
#string STR_PM_RUNTIME_DIFFERENT #language en-US "PM boot configuration differs from saved sector"
#string STR_PM_RUNTIME_REASON #language en-US "PM rejection reason"
#string STR_PM_RUNTIME_REASON_HELP #language en-US "0 none; 1 invalid PM config; 2 invalid CPU table; 3 external PMIC override; 4 debug voltage margin; 5 native rail/OPP table; 6 requested voltage; 7 boot domains; 8 coupled rail range or transition. Fixed O6N DSU can reject higher CPU requests."
#string STR_PM_HIDDEN #language en-US "Internal profile format"
#string STR_PM_GB0_0_FREQ #language en-US "GB0 OPP 0 (MHz)"
#string STR_PM_GB0_0_VOLT #language en-US "GB0 OPP 0 (min nominal mV)"
